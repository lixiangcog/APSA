import torch
import torch.nn as nn
import torch.nn.functional as F

class HKA(nn.Module):
    """Hierarchical Knowledge Aggregation"""
    def __init__(self, channels: int):
        super().__init__()
        # 使用更深的MLP来增强表达能力
        self.gap_estimator = nn.Sequential(
            nn.AdaptiveAvgPool2d(1),
            nn.Flatten(),
            nn.Linear(channels, channels // 4),
            nn.ReLU(inplace=True),
            nn.Dropout(0.1),  # 防止过拟合
            nn.Linear(channels // 4, 1)
        )
        self._init_weights()
    
    def _init_weights(self):
        """HKA初始化：让初始lambda_h接近0.5"""
        for m in self.gap_estimator.modules():
            if isinstance(m, nn.Linear):
                nn.init.normal_(m.weight, mean=0.0, std=0.02)
                if m.bias is not None:
                    nn.init.constant_(m.bias, 0.0)  # bias=0 -> sigmoid(0)=0.5
    
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        """返回lambda_h，lambda_l = 1 - lambda_h"""
        gap_score = self.gap_estimator(x)
        lambda_h = torch.sigmoid(gap_score).view(-1, 1, 1, 1)
        return lambda_h


class ViDAConvAdapter(nn.Module):
    """
    ViDA: High-rank + Low-rank adaptation with proper initialization
    
    关键改进：
    1. Identity初始化：高秩分支初始为恒等映射
    2. Zero初始化：低秩分支初始为零映射
    3. 特征归一化：防止尺度不匹配
    """
    def __init__(self, channels: int, high_dim: int = 32, low_dim: int = 4):
        super().__init__()
        
        # 高秩分支 (接近identity)
        self.h_down = nn.Conv2d(channels, high_dim, 1, bias=False)
        self.h_up = nn.Conv2d(high_dim, channels, 1, bias=False)
        
        # 低秩分支 (接近zero)
        self.l_down = nn.Conv2d(channels, low_dim, 1, bias=False)
        self.l_up = nn.Conv2d(low_dim, channels, 1, bias=False)
        
        # HKA模块
        self.hka = HKA(channels)
        
        # 特征归一化（关键！）
        self.norm_h = nn.LayerNorm([channels])
        self.norm_l = nn.LayerNorm([channels])
        
        # 论文核心：正确的初始化
        self._init_vida_weights()
    
    def _init_vida_weights(self):
        """
        ViDA论文的初始化策略：
        - 高秩分支: h_up @ h_down ≈ I (identity)
        - 低秩分支: l_up @ l_down ≈ 0 (zero)
        """
        # 高秩分支：接近identity
        # h_down: 小的正交初始化
        nn.init.orthogonal_(self.h_down.weight, gain=0.1)
        # h_up: 让 h_up @ h_down 接近单位矩阵
        with torch.no_grad():
            # 使用伪逆来构造h_up，使得h_up @ h_down ≈ I
            h_down_matrix = self.h_down.weight.data.squeeze().t()  # [C, high_dim]
            h_up_init = torch.linalg.pinv(h_down_matrix).t()  # [high_dim, C]
            self.h_up.weight.data = h_up_init.unsqueeze(-1).unsqueeze(-1)
        
        # 低秩分支：接近zero
        nn.init.normal_(self.l_down.weight, mean=0.0, std=0.001)  # 非常小的初始化
        nn.init.normal_(self.l_up.weight, mean=0.0, std=0.001)
    
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        """
        x: (B, C, H, W)
        return: (B, C, H, W)
        """
        # 高秩分支
        fh = self.h_up(self.h_down(x))
        
        # 低秩分支  
        fl = self.l_up(self.l_down(x))
        
        # 特征归一化（关键改进！）
        B, C, H, W = fh.shape
        fh_norm = self.norm_h(fh.permute(0, 2, 3, 1)).permute(0, 3, 1, 2)
        fl_norm = self.norm_l(fl.permute(0, 2, 3, 1)).permute(0, 3, 1, 2)
        
        # HKA动态加权
        lambda_h = self.hka(x)
        lambda_l = 1.0 - lambda_h
        
        # 残差连接
        out = x + lambda_h * fh_norm + lambda_l * fl_norm
        
        return out
